# Razorpay Mandate Rescue Configuration
RAZORPAY_WEBHOOK_SECRET=
WEBHOOK_SIMULATION_MODE=true
RAZORPAY_WEBHOOK_SIGNATURE_HEADER=x-razorpay-signature

# Database Path (Optional override for test isolation)
MANDATE_RESCUE_DB_PATH=data/db.json

# Batch Demo Delay in milliseconds (default 120ms)
BATCH_DEMO_DELAY_MS=120
