# ── Razorpay API Keys (Test Mode) ────────────────────────────────────────────
# Get these from Razorpay Dashboard → Settings → API Keys
# Use rzp_test_* keys for development; rzp_live_* for production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Razorpay Webhook ──────────────────────────────────────────────────────────
# Set this to the webhook secret you configured in Razorpay Dashboard:
#   Accounts & Settings → Website and app settings → Webhooks → Add New Webhook
# Leave blank during local simulation — HMAC verification is skipped when empty
RAZORPAY_WEBHOOK_SECRET=

# true  = skip HMAC verification (local dev / sandbox testing)
# false = enforce x-razorpay-signature HMAC-SHA256 verification (production)
WEBHOOK_SIMULATION_MODE=true

# The header Razorpay sends with the HMAC digest (do not change)
RAZORPAY_WEBHOOK_SIGNATURE_HEADER=x-razorpay-signature

# ── ngrok Tunnel (local dev only) ────────────────────────────────────────────
# Run:  npx ngrok http 3000
# Then paste the HTTPS URL here and register it in Razorpay Dashboard → Webhooks
# NGROK_PUBLIC_URL=https://xxxx.ngrok-free.app

# ── Database Path ─────────────────────────────────────────────────────────────
# Optional override for test isolation (default: data/db.json)
MANDATE_RESCUE_DB_PATH=data/db.json

# ── LLM Tie-Break Provider (Optional) ─────────────────────────────────────────
# Enables AI-assisted ambiguous classification — leave disabled for pure rule-based mode
NVIDIA_API_KEY=
LLM_TIEBREAK_ENABLED=false
LLM_TIEBREAK_PROVIDER=nvidia
LLM_TIEBREAK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_TIEBREAK_MAX_PER_BATCH=25
LLM_TIEBREAK_TIMEOUT_MS=8000

# ── Supabase (Optional — only needed for Postgres persistence) ────────────────
# Leave blank to use the local JSON flat-file store (data/db.json)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=

# ── Batch Engine ──────────────────────────────────────────────────────────────
# Demo delay between transactions in milliseconds (default 120ms)
BATCH_DEMO_DELAY_MS=120
